PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL: valores proporcionados por la configuración de BD del proyecto general
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SEED_PASSWORD=
SCHEDULER_ENABLED=false

# RAG
RAG_MODE=semantic
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
# Alternativa: EMBEDDING_PROVIDER=voyage. No cambies el modelo local anterior.
# Reinicia el backend y ejecuta npm run sync:drive al cambiar proveedor/modelo.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_DIMENSION=1024
# Pausas por proceso; ajusta según Usage/Limits de tu cuenta.
VOYAGE_MIN_INTERVAL_MS=21000
VOYAGE_BATCH_SIZE=16
VOYAGE_MAX_RETRIES=5
VOYAGE_MAX_RETRY_WAIT_MS=120000
VOYAGE_QUERY_INTERVAL_MS=0
# Solo para la prueba de ciclo de vida; no usar la carpeta de políticas.
DRIVE_TEST_FOLDER_ID=

# LLM
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Google Drive / Service Account
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
